// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(cuid())
  email            String?           @unique
  name             String?
  firstName        String?
  lastName         String?
  nickname         String?           @unique
  isDefault        Boolean           @default(true)
  image            String?
  emailVerified    DateTime?
  monetizationRole MonetizationRole  @default(FREE)
  workRole         WorkRole          @default(CLIENT)
  ownedBoards      Board[]           @relation("BoardOwner")
  boardMemberships BoardMember[]
  accounts         Account[]
  comments         Comment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Board {
  id          String    @id @default(cuid())
  title       String
  description String?
  logoUrl     String?
  themeColor  String?

  ownerId String?
  owner   User?     @relation("BoardOwner", fields: [ownerId], references: [id])

  tickets     Ticket[]
  columns     BoardColumn[]
  memberships BoardMember[]
  roles       BoardRole[]
  invitations BoardInvitation[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BoardMember {
  id        String             @id @default(cuid())
  role      BoardMemberRole    @default(MEMBER)
  boardId   String
  userId    String
  customRoleId String?
  board     Board              @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole BoardRole?        @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([boardId, userId])
  @@index([userId])
}

model BoardRole {
  id          String   @id @default(cuid())
  boardId     String
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name        String
  permissions String[] @default([])
  members     BoardMember[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([boardId, name])
  @@index([boardId])
}

model BoardInvitation {
  id        String   @id @default(cuid())
  token     String   @unique // URL-safe token for public invitation link
  email     String
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  role      BoardMemberRole
  status    String   @default("pending") // "pending" | "accepted" | "declined"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([boardId, email])
  @@index([boardId])
  @@index([email])
  @@index([token])
}

model BoardColumn {
  id       String @id @default(cuid())
  title    String
  position Int

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId, position])
}

model Ticket {
  id String @id

  title       String
  description String?

  status    String // "todo" | "in-progress" | "done"
  sortIndex Int    @default(0)
  priority  String // "low" | "medium" | "high" | "critical"
  type      String // "bug" | "task" | "story" | ...

  accessPolicy Json @default("{\"view\":[],\"edit\":[],\"delete\":[],\"estimate\":[],\"comment\":[],\"manageAccess\":[]}")

  boardId String
  board   Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)

  columnId String?
  column   BoardColumn? @relation(fields: [columnId], references: [id], onDelete: SetNull)

  estimateOriginalHours Int?
  estimateSpentHours    Int?
  estimateRemainingHours Int?
  storyPoints           Int?

  subtasks Subtask[]
  comments Comment[]

  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([boardId, status, sortIndex])
  @@index([boardId, columnId, sortIndex])
}

model Subtask {
  id       String  @id @default(cuid())
  title    String
  done     Boolean @default(false)

  ticketId String
  ticket   Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  body      String

  ticketId String
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?    @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum BoardMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MonetizationRole {
  FREE
  SUBMITTED
  PREMIUM
}

enum WorkRole {
  CLIENT
  EXECUTOR
  ORGANIZER
  CEO
}