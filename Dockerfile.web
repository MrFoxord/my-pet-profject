# Multi-stage build for Next.js app
FROM node:22-alpine AS builder

WORKDIR /app

# Install deps separately for better caching
COPY package.json package-lock.json* pnpm-lock.yaml* yarn.lock* bun.lockb* ./
RUN npm ci || yarn install || pnpm install || bun install

# Copy source
COPY . .

# Build Next app
RUN npm run build

# Production image
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

# Copy only necessary artefacts
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public

# Next.js respects PORT env (Cloud Run sets it automatically)
ENV PORT=3000
EXPOSE 3000

CMD ["npm", "run", "start"]
