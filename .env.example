# Подключение к PostgreSQL для Prisma и Go-сервера.
# Формат:
# postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>?schema=<SCHEMA>
#
# Примеры:
# - Локально (Windows, стандартный порт, пользователь postgres, база my_pet_profect, schema public):
#   postgresql://postgres:postgres@localhost:5432/my_pet_profect?schema=public
# - Если пароль другой:
#   postgresql://postgres:MY_STRONG_PASSWORD@localhost:5432/my_pet_profect?schema=public
#
# Обязательно создай базу my_pet_profect в PostgreSQL перед запуском миграций.

DATABASE_URL="postgresql://mypetdb_user:b0BqNLIbB6eZ1MOzms0OjaBDzJ2oYVgE@dpg-d5dm70u3jp1c73eutlqg-a.frankfurt-postgres.render.com/mypetdb"

# Базовый URL Go API для фронта
# - dev:  http://localhost:8080
# - prod: https://<your-go-service-url>
NEXT_PUBLIC_API_BASE_URL="http://localhost:8080"

# Порт HTTP-сервера Go (Cloud Run задаёт PORT автоматически)
PORT=8080

# Разрешённый CORS-origin для Go API
# - dev:  http://localhost:3000
# - prod: https://<your-frontend-domain>
ALLOWED_ORIGIN="http://localhost:3000"