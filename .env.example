# Подключение к PostgreSQL для Prisma и Nest-сервера.
# Формат:
# postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>?schema=<SCHEMA>
#
# Примеры:
# - Локально (Windows, стандартный порт, пользователь postgres, база my_pet_profect, schema public):
#   postgresql://postgres:postgres@localhost:5432/my_pet_profect?schema=public
# - Если пароль другой:
#   postgresql://postgres:MY_STRONG_PASSWORD@localhost:5432/my_pet_profect?schema=public
#
# Обязательно создай базу my_pet_profect в PostgreSQL перед запуском миграций.

DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>?schema=public"

# Auth.js secret (required in all environments)
AUTH_SECRET=change-me-very-long-random-secret

# Session strategy for Auth.js:
# - jwt      -> no DB-backed sessions (current default)
# - database -> requires Session model and DB session flow
AUTH_SESSION_STRATEGY=jwt

# OAuth provider credentials (fill those you use)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Server-to-server shared secret.
# The Next.js proxy attaches this to every request forwarded to Nest.
# Nest rejects any request that doesn't carry the correct value.
# Generate a strong random string for production (e.g. openssl rand -hex 32).
INTERNAL_API_SECRET=dev-internal-secret-change-in-prod

# Internal URL of the Nest API (server-side only, never exposed to the browser).
# In production this is the internal service URL (e.g. http://nest-service:8082).
# In Docker Compose for this repo, the web container should use: http://api:8082
NEST_API_URL=http://localhost:8082

# Базовый URL Nest API для фронта
# - dev:  http://localhost:8082
# - prod: public API URL reachable by the browser
NEXT_PUBLIC_API_BASE_URL="http://localhost:8082"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional explicit public websocket URL.
# Recommended in container/cloud deployments if websocket traffic goes through a domain
# or reverse proxy instead of direct port access.
NEXT_PUBLIC_WS_URL=

# Порт Socket.IO для клиентского подключения.
# Если не задан NEXT_PUBLIC_WS_URL, клиент сформирует URL через этот порт.
# - dev: 8082
# - prod: обычно тот же порт, что и API-шлюз
NEXT_PUBLIC_SOCKET_PORT=8082

# Срок жизни invite-ссылки в часах. По умолчанию неделя = 168 часов.
INVITE_EXPIRES_HOURS=168

# Максимум пользователей для многоразовой shared invite-ссылки.
INVITE_SHARED_MAX_USES=10

# Порт HTTP-сервера Nest (Cloud Run задаёт PORT автоматически)
PORT=8082

# Порт Socket.IO на сервере.
# По умолчанию используется тот же порт, что и HTTP API.
# Если PORT не задан, сервер возьмет SOCKET_SERVER_PORT.
SOCKET_SERVER_PORT=8082

# Разрешённый CORS-origin для Nest API
# - dev:  http://localhost:3000
# - prod: https://<your-frontend-domain>
ALLOWED_ORIGIN="http://localhost:3000"

# Swagger/OpenAPI
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# Global API rate limit
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Docker Compose database defaults used by docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=my_pet_profect